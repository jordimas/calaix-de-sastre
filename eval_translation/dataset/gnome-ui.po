msgstr ""
"Establiu-ho a «true» per a mostrar només les aplicacions dels "
"desenvolupadors la identitat dels quals s'ha verificat."

# Source: /gnome-software.gnome-48.ca.po from project 'GNOME - gnome-ui'
#: data/org.gnome.software.gschema.xml:151
msgid "The timestamp of the last received historical updates."
msgstr "La marca horària de l'última actualització històrica rebuda."

# Source: /gnome-software.gnome-48.ca.po from project 'GNOME - gnome-ui'
#: data/org.gnome.software.gschema.xml:158
