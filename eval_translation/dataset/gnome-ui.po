msgstr "Mostra el dia de la setmana al rellotge"

# Source: /gsettings-desktop-schemas.gnome-48.ca.po from project 'GNOME -
# gnome-ui'
#: schemas/org.gnome.desktop.interface.gschema.xml.in:235
