msgstr "Pronuncia les línies en blanc"

# Source: /orca.gnome-48.ca.po from project 'GNOME - gnome-ui'
#: src/orca/orca-setup.ui:1678
msgid "Speak _indentation and justification"
msgstr "Pronunc_ia el sagnat i la justificació"

# Source: /orca.gnome-48.ca.po from project 'GNOME - gnome-ui'
#: src/orca/orca-setup.ui:1693
msgid "Spea_k object mnemonics"
msgstr "Pronuncia els _mnemònics de l'objecte"

# Source: /orca.gnome-48.ca.po from project 'GNOME - gnome-ui'
#. Translators: This checkbox toggles whether or not Orca says the child
