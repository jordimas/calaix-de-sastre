msgid "Speak child p_osition"
msgstr "Pronuncia la p_osició filla"

# Source: /orca.gnome-48.ca.po from project 'GNOME - gnome-ui'
#: src/orca/orca-setup.ui:1725
msgid "Speak tutorial messages"
